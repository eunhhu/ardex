{
  "name": "ardex",
  "version": "0.1.4",
  "description": "Local autonomy control plane for Codex workflows",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eunhhu/ardex.git"
  },
  "bugs": {
    "url": "https://github.com/eunhhu/ardex/issues"
  },
  "homepage": "https://github.com/eunhhu/ardex#readme",
  "keywords": [
    "codex",
    "codex-cli",
    "agent",
    "agent-workflow",
    "autonomy",
    "control-plane",
    "local-dashboard",
    "workflow",
    "sdd",
    "vdd",
    "visible-outputs",
    "local-first"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "ardex": "bin/ardex"
  },
  "files": [
    "bin",
    "index.ts",
    "src",
    "web",
    "web-dist",
    "docs",
    "vite.config.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:web",
    "build:web": "vite build",
    "check": "bunx tsc --noEmit",
    "dev:web": "vite --host 127.0.0.1",
    "prepack": "bun run build:web",
    "test": "bun test",
    "dev": "bun run index.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/bun": "latest",
    "vite": "^8.0.13"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "preact": "^10.29.2"
  }
}
